  have hlow' : 4 * D * (X : ℝ) ≤ 4 * D * (X : ℝ) * Real.log (Real.log (X : ℝ)) := by
    have hcoef : 0 ≤ 4 * D * (X : ℝ) := by positivity
    exact le_mul_of_one_le_right hcoef hLLX
  have hsum' :
      4 * (X : ℝ) * D * Real.log (Real.log (X : ℝ)) +
          748 * (X : ℝ) + 4 * D * (X : ℝ) ≤
