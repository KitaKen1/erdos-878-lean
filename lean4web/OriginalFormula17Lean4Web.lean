        (Rmax : ℝ) *
          (C * Real.log (Real.log (X : ℝ)) / Real.log (X : ℝ)) := by
    simp [Finset.sum_const]
  have hmul := mul_le_mul_of_nonneg_right hR hq
  rw [hsumConst] at hsum
  calc
    (∑ r ∈ Finset.range Rmax, sourceExponentBrunBudget X Y z r) ≤
