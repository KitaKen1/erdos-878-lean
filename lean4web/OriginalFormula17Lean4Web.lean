/-- A finite, rounded version of the prime-counting/product-budget construction. -/
theorem log_div_log_sub_one_le_h
    {X Y : ℕ} (hX : 0 < X) (hY : 1 < Y)
    (hnum : Real.log (X : ℝ) ≤
      (Y : ℝ) * Real.log 2 - Real.log ((Y : ℝ) + 1)) :
