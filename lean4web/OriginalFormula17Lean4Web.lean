      ∀ p ∈ S, ¬((p : ℕ) ^ 2 ∣ N) ∧ ∀ d ∈ T, ¬((p : ℕ) ^ 2 ∣ b * N + d)).card =
      (X / M) * A.card := by
    simp_all
  rw [hsum]
  linarith [partialBlock_valid_count_le b T S X]

