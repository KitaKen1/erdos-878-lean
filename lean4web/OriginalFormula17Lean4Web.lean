      |(b : ℝ) * (Q - ((h : ℝ) / (r : ℝ)) * L)| ≤ L / (M : ℝ) := by
    have hbound : (b : ℝ) * |Q / L - (h : ℝ) / (r : ℝ)| ≤
        (b : ℝ) * (1 / ((r : ℝ) * (M : ℝ))) :=
