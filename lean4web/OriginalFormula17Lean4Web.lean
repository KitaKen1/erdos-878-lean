  rw [hrepr]
  have hfloor₁' : (j : ℝ) * L / (r : ℝ) ≤ t - L / (M : ℝ) := by
    apply (div_le_iff₀ hrR).2
    have hmul := mul_le_mul_of_nonneg_right hfloor₁ hL.le
    field_simp [hL.ne'] at hmul ⊢
    nlinarith
  have hfloor₂' : t - L / (M : ℝ) - L / (r : ℝ) <
      (j : ℝ) * L / (r : ℝ) := by
    apply (lt_div_iff₀ hrR).2
