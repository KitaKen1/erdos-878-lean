  have hr' : (r : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.pos_iff_ne_zero.mp hr)
  have heq : ((X : ℚ) - v) / r - (-(v : ℚ)) / r = (X : ℚ) / r := by field_simp; ring
