noncomputable def transitionWeight (Y m q : ℕ) : ℝ :=
  if Y ≤ q then
    (Real.log (m : ℝ) / (Real.log ((m * q : ℕ) : ℝ)) ^ 2) * (Λ q / (q : ℝ))
  else 0

