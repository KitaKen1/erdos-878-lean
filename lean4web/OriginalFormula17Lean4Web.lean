noncomputable def ry (Y m : ℕ) : ℝ :=
  ∑' q : ℕ,
    if Y ≤ q then
      (Real.log (m : ℝ) / (Real.log ((m * q : ℕ) : ℝ)) ^ 2) * (Λ q / (q : ℝ))
    else 0

