  have hrR : 0 < (r : ℝ) := by exact_mod_cast hr
  have hbR : 0 ≤ (b : ℝ) := by positivity
  have hb_lt : (b : ℝ) < (r : ℝ) := by exact_mod_cast hb
  have hcongR : (r : ℝ) * (a : ℝ) + (b : ℝ) * (h : ℝ) = (j : ℝ) := by
    exact_mod_cast hcong
