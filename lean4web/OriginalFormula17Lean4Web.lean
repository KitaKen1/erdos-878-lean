  intro M count blockCounts partialCount
  set P := fun N => ∀ p ∈ S, ¬((p : ℕ) ^ 2 ∣ N) ∧ ∀ d ∈ T, ¬((p : ℕ) ^ 2 ∣ b * N + d) with hP
  have hM : 0 < M := primeSquareProduct_pos S
  have h_partition := Icc_eq_biUnion_union_partialBlock M X hM
