  have hidx := eventually_source_cutoff_log_index_le_two_loglog
  have hsmall := eventually_dyadicEndpointSmallPrime_mass_le_source_cutoff_log
  filter_upwards [hLL, hidx, hsmall] with X hLLX hidxX hsmallX
  have hsmall' :
