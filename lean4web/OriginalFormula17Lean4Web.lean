  let D : ℝ := A + 3 * c + 324
  have hA : 0 ≤ A := by
    dsimp [A]
    positivity
  have hc : 0 ≤ c := by
    dsimp [c]
    positivity
  have hbase : 0 ≤ A + c + 324 := by positivity
  have hLL : ∀ᶠ X : ℕ in atTop,
      1 ≤ Real.log (Real.log (X : ℝ)) := by
    exact ((Real.tendsto_log_atTop.comp Real.tendsto_log_atTop).comp
