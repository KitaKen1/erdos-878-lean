        dyadicEndpointWeight X p) ≤
        4 * (X : ℝ) *
          (A + c * (1 + Real.log ((Nat.log 16 (sourceBasePrimeCutoff X) + 1 : ℕ) : ℝ)) + 324) := by
    simpa [A, c, mul_assoc] using hsmallX
  have hlogterm :
